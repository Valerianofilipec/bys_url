# Set to production when deploying to production
NODE_ENV=development

# Node.js server configuration
SERVER_PORT=3000
HOST_URL=
HASHID_SALT=KFCsalt
SHORT_URL_HOST=https://bys.codes/

# Redis INCR
INCR_PORT=3379
INCR_URL=redis://localhost:3379

# Redis CACHE
CACHE_PORT=4379
CACHE_URL=redis://localhost:4379

# Database Postgres configuration
CASSANDRA_USER=admin
CASSANDRA_PASSWORD=admin
CASSANDRA_CLUSTER_NAME=cassandracluster
CASSANDRA_DATA_CENTER=datacenter1
CASSANDRA_HOST=localhost
CASSANDRA_KEYSPACE=bys_url

# Nginx env
NGINX_HOST=localhost
NGINX_PORT=80
